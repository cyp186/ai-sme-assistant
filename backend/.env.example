DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_sme_assistant
SECRET_KEY=change-me-to-a-long-random-string
OPENAI_API_KEY=your-openai-key-here

# Email verification (leave SMTP_HOST empty for local dev — codes log to the server console)
# Gmail: create a dedicated account, enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords — use that as SMTP_PASSWORD (not your normal password)
VERIFICATION_CODE_EXPIRE_MINUTES=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp.noreply@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=yourapp.noreply@gmail.com
SMTP_USE_TLS=true